{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch Gwire",
      "type": "process",
      "command": "dotnet",
      "args": [
        "watch",
        "--project",
        "${workspaceFolder}/Gwire/Gwire.csproj",
        "run",
        "--launch-profile",
        "http"
      ],
      "isBackground": true,
      "problemMatcher": {
        "base": "$msCompile",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Now listening on:.*"
        }
      }
    }
  ]
}
