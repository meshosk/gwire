{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Gwire: watch",
      "type": "process",
      "command": "dotnet",
      "args": [
        "watch",
        "--project",
        "${workspaceFolder}/Gwire/Gwire.csproj",
        "run",
        "--launch-profile",
        "http"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DOTNET_WATCH_SUPPRESS_LAUNCH_BROWSER": "1"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "base": "$msCompile",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*dotnet watch.*Building.*",
          "endsPattern": ".*Now listening on: http://localhost:5188/?\\s*$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
