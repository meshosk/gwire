{
  "name": "gwire-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Gwire guitar wiring diagram editor",
  "author": "meshosk",
  "main": "main.cjs",
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "io.github.meshosk.gwire",
    "productName": "Gwire",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "client/wwwroot",
        "to": "client"
      }
    ],
    "artifactName": "Gwire-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.music",
      "identity": "-",
      "hardenedRuntime": false,
      "target": "dir"
    },
    "win": {
      "target": "portable"
    }
  }
}
