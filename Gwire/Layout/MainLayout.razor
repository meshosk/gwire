@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Sections

<div class="app-shell" inert="@(showRepositoryLoading ? string.Empty : null)">
    <header class="app-toolbar border-bottom bg-body-tertiary px-2 py-2" aria-label="Main toolbar">
        <nav class="border-end pe-2" aria-label="Editors">
            <NavLink href="scheme-editor" class="btn btn-sm btn-outline-secondary" title="Scheme editor" aria-label="Scheme editor">
                <i class="fa-solid fa-diagram-project" aria-hidden="true"></i>
            </NavLink>
            <NavLink href="part-editor" class="btn btn-sm btn-outline-secondary" title="Parts editor" aria-label="Parts editor">
                <i class="fa-solid fa-microchip" aria-hidden="true"></i>
            </NavLink>
        </nav>
        <div class="editor-toolbar-content">
            <SectionOutlet SectionName="editor-toolbar" />
        </div>
    </header>

    <main class="workspace">
        @if (canUseApp)
        {
            <CascadingValue Name="ReloadRepository" Value="@EventCallback.Factory.Create(this, ReloadRepository)">
                @Body
            </CascadingValue>
        }
    </main>
</div>

<MessageToasts />
<ConfirmationModal />

@if (showRepositoryLoading)
{
    <RepositoryLoadingDialog Error="@repositoryError" LoadRequested="LoadRepositoryAsync" ContinueRequested="ContinueWithoutRepository" />
}
