@page "/part-editor"

@using Gwire.Components.Displayers.SearchDialog
@using Gwire.Components.Tabs
@using Gwire.Extensions
@using Gwire.Models
@using Gwire.Models.Base
@using Microsoft.AspNetCore.Components.Sections

<PageTitle>Gwire - The part editor</PageTitle>

<SectionContent SectionName="editor-toolbar">
    <div class="part-editor-toolbar d-flex flex-wrap align-items-center gap-2"
         role="toolbar" aria-label="Part editor toolbar">
        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="NewPart" title="New part" aria-label="New part">
            <i class="fa-solid fa-file-circle-plus" aria-hidden="true"></i>
        </button>
        <div class="btn-group btn-group-sm" role="group" aria-label="Part files">
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="LoadSelectedPart"
                    disabled="@(!AvailableParts.Any() || PartSearchIsShown)" title="Get part from repo" aria-label="Get part from repo">
                <i class="fa-solid fa-cloud-arrow-down"  aria-hidden="true"></i>
            </button>
            <label class="btn btn-sm btn-outline-primary mb-0" for="part-import" title="Import JSON" aria-label="Import JSON">
                <i class="fa-solid fa-file-import" aria-hidden="true"></i>
            </label>
            <InputFile id="part-import" class="visually-hidden" accept="application/json,.json" OnChange="ImportPartAsync" />
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ExportPartAsync" title="Export JSON" aria-label="Export JSON">
                <i class="fa-solid fa-file-export" aria-hidden="true"></i>
            </button>
  
        </div>
        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="SavePartToService" title="@(EditorStateService.PartEditor.EditedPart.IsFromRepo ? "Save as own copy locally" : "Save locally")" aria-label="@(EditorStateService.PartEditor.EditedPart.IsFromRepo ? "Save as own copy locally" : "Save locally")">
            <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ReloadRepository" disabled="@history.IsFrozen"
                title="Reload repository data" aria-label="Reload repository data">
            <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
        </button>
        <div class="btn-group btn-group-sm" role="group" aria-label="Edit history">
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="history.Undo" disabled="@(!history.CanUndo)" title="Undo" aria-label="Undo">
                <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="history.Redo" disabled="@(!history.CanRedo)" title="Redo" aria-label="Redo">
                <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</SectionContent>

<div class="part-editor" @ref="editorElement" tabindex="0">
	<div class="part-editor-layout">
		<aside class="editor-sidebar">
			<div class="editor-controls">
	            <section class="card shadow-sm point-panel p-2">
		            <BootstrapTabs @key="partTabsKey" @bind-ActiveIndex="EditorStateService.PartEditor.ActiveTabIndex">
			            <BootstrapTab Title="Part">
				            <div class="mb-3">
					            <label for="part-name" class="form-label">Title</label>
					            <input class="form-control" id="part-name" @bind:get="EditorStateService.PartEditor.EditedPart.Name" @bind:set="value => ExecuteEdit(() => EditorStateService.PartEditor.EditedPart.Name = value ?? string.Empty)" aria-label="Part name" />
				            </div>
			               <div class="mb-3">
			                  <label for="part-description" class="form-label">Description</label>
			                  <textarea class="form-control" @bind:get="EditorStateService.PartEditor.EditedPart.Description" @bind:set="value => ExecuteEdit(() => EditorStateService.PartEditor.EditedPart.Description = value ?? string.Empty)" id="part-description" rows="3"></textarea>
			               </div>
                    <div class="form-check mb-3">
                        <input id="part-has-value" class="form-check-input" type="checkbox"
                               @bind:get="@(EditorStateService.PartEditor.EditedPart.CustomTextValue is not null)" @bind:set="SetCustomTextEnabled" />
                        <label class="form-check-label" for="part-has-value">Editable value</label>
                    </div>
                    @if (EditorStateService.PartEditor.EditedPart.CustomTextValue is not null)
                    {
                        <div class="mb-3">
                            <label class="form-label" for="part-value">Example value</label>
                            <input id="part-value" class="form-control" @bind:get="EditorStateService.PartEditor.EditedPart.CustomTextValue"
                                   @bind:set="value => ExecuteEdit(() => EditorStateService.PartEditor.EditedPart.CustomTextValue = value ?? string.Empty)" />
                        </div>
                    }
			               <div class="row g-2 mb-3">
			                  <div class="col-6">
			                     <label for="part-width" class="form-label">Width (px)</label>
			                     <input id="part-width" class="form-control" type="number" @bind:get="EditorStateService.PartEditor.EditedPart.Width" @bind:set="value => ExecuteEdit(() => EditorStateService.PartEditor.EditedPart.Width = value)" />
			                  </div>
			                  <div class="col-6">
			                     <label for="part-height" class="form-label">Height (px)</label>
			                     <input id="part-height" class="form-control" type="number" @bind:get="EditorStateService.PartEditor.EditedPart.Height" @bind:set="value => ExecuteEdit(() => EditorStateService.PartEditor.EditedPart.Height = value)" />
			                  </div>
			               </div>
			               <div class="mb-3">
			                  <label for="part-tag" class="form-label">Tags</label>
			                  @if (EditorStateService.PartEditor.EditedPart.Tags.Count > 0)
			                  {
			                     <div class="d-flex flex-wrap gap-2 mb-2">
			                        @foreach (var tag in EditorStateService.PartEditor.EditedPart.Tags)
			                        {
			                           <span class="badge text-bg-secondary d-flex align-items-center gap-1">
			                              @tag
			                              <button type="button" class="btn-close btn-close-white" aria-label="Remove @tag tag" @onclick="() => ExecuteEdit(() => RemoveTag(tag))"></button>
			                           </span>
			                        }
			                     </div>
			                  }
                          <div class="position-relative" @onkeydown="HandleTagKeyDown">
                              <input class="form-control" id="part-tag" placeholder="Search existing tags" autocomplete="off"
                                     role="combobox" aria-autocomplete="list" aria-controls="part-tag-options"
                                     aria-expanded="@(EditorStateService.PartEditor.ShowTagSuggestions && TagSuggestions.Count > 0 ? "true" : "false")"
                                     aria-activedescendant="@(EditorStateService.PartEditor.ShowTagSuggestions && TagSuggestions.Count > 0 ? $"part-tag-option-{EditorStateService.PartEditor.ActiveTagSuggestionIndex}" : null)"
                                     @bind="EditorStateService.PartEditor.SelectedTag" @bind:event="oninput" @bind:after="ResetTagSuggestions"
                                     @onfocus="ResetTagSuggestions" @onblur="CloseTagSuggestions"
                                     onkeydown="if (['ArrowDown', 'ArrowUp', 'Enter'].includes(event.key)) event.preventDefault();"
                                     disabled="@(AvailableTags.Count == 0)" />
                              @if (EditorStateService.PartEditor.ShowTagSuggestions)
                              {
                                  var suggestions = TagSuggestions;
                                  <div id="part-tag-options" class="tag-suggestions list-group shadow-sm" role="listbox" aria-label="Existing tags">
                                      @for (var index = 0; index < suggestions.Count; index++)
                                      {
                                          var suggestionIndex = index;
                                          var tag = suggestions[index];
                                          <button type="button" id="part-tag-option-@index" tabindex="-1" role="option"
                                                  class="list-group-item list-group-item-action @(index == EditorStateService.PartEditor.ActiveTagSuggestionIndex ? "active" : null)"
                                                  aria-selected="@(index == EditorStateService.PartEditor.ActiveTagSuggestionIndex ? "true" : "false")"
                                                  @onmousedown:preventDefault="true"
                                                  @onmouseover="() => EditorStateService.PartEditor.ActiveTagSuggestionIndex = suggestionIndex"
                                                  @onclick="() => AddTag(tag)">@tag</button>
                                      }
                                      @if (suggestions.Count == 0)
                                      {
                                          <div class="list-group-item text-body-secondary" role="status">No matching tags.</div>
                                      }
                                  </div>
                              }
                          </div>
			               </div>
			               <div class="mb-3">
			                  <label class="form-label">SVG background</label>
			                  <div class="d-flex flex-wrap gap-2">
			                     <label class="btn btn-outline-primary mb-0" for="part-svg-import">
			                        <i class="fa-solid fa-image me-1" aria-hidden="true"></i>Upload SVG
			                     </label>
			                     <InputFile id="part-svg-import" class="visually-hidden" accept="image/svg+xml,.svg" OnChange="ImportSvgAsync" />
			                     @if (!string.IsNullOrWhiteSpace(EditorStateService.PartEditor.EditedPart.SvgMarkup))
			                     {
			                        <button type="button" class="btn btn-outline-danger" @onclick="() => ExecuteEdit(RemoveSvg)">Remove SVG</button>
			                     }
			                  </div>
			               </div>
			               @if (!string.IsNullOrWhiteSpace(EditorStateService.PartEditor.EditedPart.SvgMarkup))
			               {
			                  <div class="row g-2 mb-3">
			                     <div class="col-6">
			                        <label class="form-label" for="svg-x">SVG X</label>
				                        <input id="svg-x" class="form-control" type="number" @bind:get="EditorStateService.PartEditor.EditedPart.SvgLocalPosition.X" @bind:set="(float value) => ExecuteEdit(() => EditorStateService.PartEditor.EditedPart.SvgLocalPosition = new Point(value, EditorStateService.PartEditor.EditedPart.SvgLocalPosition.Y))" />
			                     </div>
			                     <div class="col-6">
			                        <label class="form-label" for="svg-y">SVG Y</label>
				                        <input id="svg-y" class="form-control" type="number" @bind:get="EditorStateService.PartEditor.EditedPart.SvgLocalPosition.Y" @bind:set="(float value) => ExecuteEdit(() => EditorStateService.PartEditor.EditedPart.SvgLocalPosition = new Point(EditorStateService.PartEditor.EditedPart.SvgLocalPosition.X, value))" />
			                     </div>
			                  </div>
			                  <div class="mb-3">
			                     <label class="form-label" for="svg-rotation">SVG rotation (degrees)</label>
			                     <input id="svg-rotation" class="form-control" type="number" @bind:get="EditorStateService.PartEditor.EditedPart.SvgRotation" @bind:set="value => ExecuteEdit(() => EditorStateService.PartEditor.EditedPart.SvgRotation = value)" />
			                  </div>
			               }
			            </BootstrapTab>
			            <BootstrapTab Title="Points">
				            <div class="mb-1">
					            <div class="d-grid gap-2">
						            <button type="button" class="btn btn-primary" @onclick="() => ExecuteEdit(AddPoint)">Add connection point</button>
					            </div>
				            </div>

                    @if (EditorStateService.PartEditor.EditedPart.Points.Count > 0)
                    {
                        <fieldset class="border rounded p-2 mt-2">
                            <legend class="float-none w-auto px-1 mb-0 fs-6">Points</legend>
                            <div class="d-flex flex-wrap gap-1">

                        @foreach (var point in EditorStateService.PartEditor.EditedPart.Points)
                                {
                                    <button @key="point" type="button"
                                            class="btn btn-sm @(ReferenceEquals(point, EditorStateService.PartEditor.SelectedPointInEditor) ? "btn-primary" : "btn-outline-secondary")"
                                            aria-pressed="@(ReferenceEquals(point, EditorStateService.PartEditor.SelectedPointInEditor) ? "true" : "false")"
                                            @onclick="() => EditorStateService.PartEditor.SelectedPointInEditor = point">
                                        @(string.IsNullOrWhiteSpace(point.Label) ? "Unnamed point" : point.Label)
                                    </button>
                                }
                            </div>
                        </fieldset>
                    }

					            @if (EditorStateService.PartEditor.SelectedPointInEditor is not null)
					            {
						            <div class="mt-2">
							            <label class="form-label" for="point-label">Point name</label>
							            <input id="point-label" class="form-control mb-3" @bind:get="EditorStateService.PartEditor.SelectedPointInEditor.Label" @bind:set="value => ExecuteEdit(() => EditorStateService.PartEditor.SelectedPointInEditor.Label = value ?? string.Empty)"/>
							            <div class="row g-2 mb-3">
								            <div class="col-6">
									            <label class="form-label" for="point-x">X</label>
								            <input id="point-x" class="form-control" type="number" @bind:get="EditorStateService.PartEditor.SelectedPointInEditor.LocalPosition.X" @bind:set="(float value) => ExecuteEdit(() => EditorStateService.PartEditor.SelectedPointInEditor.LocalPosition = new Point(value, EditorStateService.PartEditor.SelectedPointInEditor.LocalPosition.Y))"/>
								            </div>
								            <div class="col-6">
									            <label class="form-label" for="point-y">Y</label>
								            <input id="point-y" class="form-control" type="number" @bind:get="EditorStateService.PartEditor.SelectedPointInEditor.LocalPosition.Y" @bind:set="(float value) => ExecuteEdit(() => EditorStateService.PartEditor.SelectedPointInEditor.LocalPosition = new Point(EditorStateService.PartEditor.SelectedPointInEditor.LocalPosition.X, value))"/>
								            </div>
							            </div>
							            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => ExecuteEdit(RemoveSelectedPoint)">Delete selected Point</button>
							            </div>
					            }

			            </BootstrapTab>
			            <BootstrapTab Title="States" Disabled="@(!EditorStateService.PartEditor.EditedPart.Points.Any())">

                    @if (EditorStateService.PartEditor.EditedPart.StateGroups.Count > 1)
                    {
                        <div class="mb-2">
                            <label class="form-label" for="state-group-selection">State group</label>
                            <select id="state-group-selection" class="form-select"
                                    @bind:get="EditorStateService.PartEditor.ActiveStateGroupIndex" @bind:set="SelectStateGroup">
                                @for (var index = 0; index < EditorStateService.PartEditor.EditedPart.StateGroups.Count; index++)
                                {
                                    <option value="@index">@EditorStateService.PartEditor.EditedPart.StateGroups[index].Label</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="mb-2">
                        <label class="form-label" for="state-group-name">State group name</label>
                        <input id="state-group-name" class="form-control" @bind:get="EditorStateService.PartEditor.ActiveStateGroupInEditor.Label"
                               @bind:set="value => ExecuteEdit(() => EditorStateService.PartEditor.ActiveStateGroupInEditor.Label = value ?? string.Empty)" />
                    </div>
                    <div class="d-flex gap-2 mb-3">
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => ExecuteEdit(AddStateGroup)">Add state group</button>
                        <button type="button" class="btn btn-outline-danger btn-sm" disabled="@(EditorStateService.PartEditor.EditedPart.StateGroups.Count <= 1)"
                                @onclick="() => ExecuteEdit(RemoveStateGroup)">Remove state group</button>
                    </div>

                    <h2 class="state-section-divider">States</h2>

				            <div class="mb-1">
					            <div class="d-grid gap-2">
						            <button type="button" class="btn btn-primary" @onclick="() => ExecuteEdit(AddState)">Add state</button>
								</div>
				            </div>
                    @if (EditorStateService.PartEditor.ActiveStateGroupInEditor.States.Count > 0)
                    {
                        <div class="mt-3">
                            <div class="nav nav-tabs" role="group" aria-label="States">
                                @foreach (var candidateState in EditorStateService.PartEditor.ActiveStateGroupInEditor.States)
                                {
                                    <button @key="candidateState" type="button"
                                            class="nav-link @(ReferenceEquals(candidateState, EditorStateService.PartEditor.ActiveStateInEditor) ? "active" : null)"
                                            aria-pressed="@(ReferenceEquals(candidateState, EditorStateService.PartEditor.ActiveStateInEditor) ? "true" : "false")"
                                            @onclick="() => SelectActiveState(candidateState)">@candidateState.Label</button>
                                }
                            </div>
                            @if (EditorStateService.PartEditor.ActiveStateInEditor is { } state)
                            {
                                <div class="pt-3" @key="state">
                                    <label class="form-label" for="state-label">State name</label>
                                    <input id="state-label" class="form-control mb-4" @bind:get="state.Label" @bind:set="value => ExecuteEdit(() => state.Label = value ?? string.Empty)" />

                                    <div class="d-grid gap-2">
                                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => ExecuteEdit(() => CopyState(state))">Create copy</button>
                                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => ExecuteEdit(() => RemoveState(state))">Remove state</button>
                                    </div>

                                    <h3 class="state-section-divider">Connection groups</h3>

                                    <div class="d-grid gap-2">
                                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => ExecuteEdit(() => AddConnectionGroup(state))">Add group</button>
                                    </div>

                                    @if (state.ConnectionGroups.Count > 0)
                                    {
                                        <div class="p-3">
                                            <BootstrapTabs @bind-ActiveIndex="EditorStateService.PartEditor.ConnectionGroupTabIndex">
                                                @foreach (var group in state.ConnectionGroups.WithIndex())
                                                {
                                                    <BootstrapTab @key="group.Item" Title="@($"Group {group.Index}")">
                                                        <div class="m-2">
                                                            Connected:
                                                            @foreach (var connectedPin in group.Item.ConnectedPints)
                                                            {
                                                                <span class="badge text-bg-secondary d-inline-flex align-items-center gap-1">
                                                                    @connectedPin.Label
                                                                    <button type="button" class="btn-close btn-close-white" aria-label="Remove @connectedPin.Label from group"
                                                                            @onclick="() => ExecuteEdit(() => group.Item.ConnectedPints.Remove(connectedPin))"></button>
                                                                </span>
                                                            }
                                                        </div>
                                                        <div class="d-flex flex-wrap gap-2">
                                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => ExecuteEdit(() => AddRemovePointToGroup(group.Item, EditorStateService.PartEditor.SelectedPointInEditor))">Selected point to group</button>
                                                            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => ExecuteEdit(() => RemoveActiveConnectionGroup(group.Item))">Remove group</button>
                                                        </div>
                                                    </BootstrapTab>
                                                }
                                            </BootstrapTabs>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
			            </BootstrapTab>
		            </BootstrapTabs>




	            </section>


            </div>
        </aside>

        <section class="editor-canvas-panel" aria-label="SVG scheme"
                 @onpointermove="MoveDraggedItem"
                 @onpointerup="EndPointDrag"
                 @onpointercancel="CancelPointDrag"
                 @onpointerleave="EndPointDrag">
            <Gwire.Components.PartSvgBackground @key="EditorStateService.PartEditor.EditedPart" @bind-Part="EditorStateService.PartEditor.EditedPart"
                                                EditStarted="BeginEdit" EditCompleted="CompleteEdit" EditCanceled="CancelEdit">

                        @foreach (var stateGroup in EditorStateService.PartEditor.EditedPart.StateGroups.Where(group => group.ActiveState is not null))
                        {
                            @foreach (var group in stateGroup.ActiveState!.ConnectionGroups.WithIndex())
                            {
                                var points = group.Item.ConnectedPints;
                                @for (var firstIndex = 0; firstIndex < points.Count - 1; firstIndex++)
                                {
                                    @for (var secondIndex = firstIndex + 1; secondIndex < points.Count; secondIndex++)
                                    {
                                        <line x1="@points[firstIndex].LocalPosition.X" y1="@points[firstIndex].LocalPosition.Y" x2="@points[secondIndex].LocalPosition.X" y2="@points[secondIndex].LocalPosition.Y" class="connection-line-outline" />
                                        <line x1="@points[firstIndex].LocalPosition.X" y1="@points[firstIndex].LocalPosition.Y" x2="@points[secondIndex].LocalPosition.X" y2="@points[secondIndex].LocalPosition.Y" class="connection-line" style="stroke: @ConnectionGroup.GetLineColor(group.Index)" />
                                    }
                                }
                            }
                        }

                        @foreach (var point in EditorStateService.PartEditor.EditedPart.Points)
                        {
                            <circle cx="@point.LocalPosition.X"
                                    cy="@point.LocalPosition.Y"
                                    r="10"
                                    class="@PointClass(point)"
                                    @onpointerdown="(eventArgs) => StartPointDrag(point, eventArgs)" />
                            <svg:text x="@(point.LocalPosition.X + 15)"
                                      y="@(point.LocalPosition.Y + 5)"
                                      class="point-label"
                                      @onpointerdown="(eventArgs) => StartPointDrag(point, eventArgs)">@point.Label</svg:text>
                        }

                @if (EditorStateService.PartEditor.EditedPart.CustomTextValue is not null)
                {
                    <g class="part-value" @onpointerdown="StartValueDrag" @onpointerdown:stopPropagation="true">
                        <circle cx="@EditorStateService.PartEditor.EditedPart.ValuePosition.X" cy="@EditorStateService.PartEditor.EditedPart.ValuePosition.Y" r="7" class="value-handle">
                            <title>Drag to position the value</title>
                        </circle>
                        <svg:text x="@EditorStateService.PartEditor.EditedPart.ValuePosition.X" y="@(EditorStateService.PartEditor.EditedPart.ValuePosition.Y + 14)"
                                  text-anchor="middle" dominant-baseline="hanging" class="value-label">@EditorStateService.PartEditor.EditedPart.CustomTextValue</svg:text>
                    </g>
                }

            </Gwire.Components.PartSvgBackground>
        </section>
    </div>
</div>

<SearchDialog Options="partSearchOptions" @bind-Visible="PartSearchIsShown" />
