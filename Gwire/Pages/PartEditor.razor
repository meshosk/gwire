@page "/part-editor"

@using Gwire.Components.Tabs
@using Gwire.Extensions
@using Gwire.Models
@using Gwire.Models.Base

<PageTitle>Gwire - The part editor</PageTitle>

<NavigationLock ConfirmExternalNavigation="HasUnsavedChanges" OnBeforeInternalNavigation="ConfirmNavigationAsync" />

<div class="part-editor" @ref="editorElement" tabindex="0">
    <div class="part-editor-toolbar d-flex flex-wrap align-items-center gap-2 border-bottom bg-body-tertiary px-2 py-2"
         role="toolbar" aria-label="Part editor toolbar">
        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="NewPart">
            <i class="fa-solid fa-file-circle-plus me-1" aria-hidden="true"></i>New part
        </button>
        <label class="btn btn-sm btn-outline-primary mb-0" for="part-import">
            <i class="fa-solid fa-file-import me-1" aria-hidden="true"></i>Import JSON
        </label>
        <InputFile id="part-import" class="visually-hidden" accept="application/json,.json" OnChange="ImportPartAsync" />
        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ExportPartAsync">
            <i class="fa-solid fa-file-export me-1" aria-hidden="true"></i>Export JSON
        </button>
        <div class="input-group input-group-sm part-editor-part-picker">
            <select class="form-select" aria-label="Part to edit" @bind="selectedPartId" disabled="@(!AvailableParts.Any())">
                <option value="">Select a part to edit</option>
                @foreach (var part in AvailableParts)
                {
                    <option value="@part.Id">@part.DisplayName</option>
                }
            </select>
            <button type="button" class="btn btn-outline-primary" @onclick="LoadSelectedPart" disabled="@(selectedPartId is null)">
                <i class="fa-solid fa-folder-open me-1" aria-hidden="true"></i>Open
            </button>
        </div>
        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="SavePartToService">
            <i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i>@(EditedPart.IsFromRepo ? "Save as own copy" : "Save to service")
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="history.Undo" disabled="@(!history.CanUndo)">
            <i class="fa-solid fa-rotate-left me-1" aria-hidden="true"></i>Undo
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="history.Redo" disabled="@(!history.CanRedo)">
            <i class="fa-solid fa-rotate-right me-1" aria-hidden="true"></i>Redo
        </button>
    </div>
	<div class="part-editor-layout">
		<aside class="editor-sidebar">
			<div class="editor-controls">
	            <section class="card shadow-sm point-panel p-2">
		            <BootstrapTabs>
			            <BootstrapTab Title="Part">
				            <div class="mb-3">
					            <label for="part-name" class="form-label">Title</label>
					            <input class="form-control" id="part-name" @bind:get="EditedPart.Name" @bind:set="value => ExecuteEdit(() => EditedPart.Name = value ?? string.Empty)" aria-label="Part name" />
				            </div>
			               <div class="mb-3">
			                  <label for="part-description" class="form-label">Description</label>
			                  <textarea class="form-control" @bind:get="EditedPart.Description" @bind:set="value => ExecuteEdit(() => EditedPart.Description = value ?? string.Empty)" id="part-description" rows="3"></textarea>
			               </div>
                    <div class="form-check mb-3">
                        <input id="part-has-value" class="form-check-input" type="checkbox"
                               @bind:get="EditedPart.HasValue" @bind:set="value => ExecuteEdit(() => EditedPart.HasValue = value)" />
                        <label class="form-check-label" for="part-has-value">Editable value</label>
                    </div>
                    @if (EditedPart.HasValue)
                    {
                        <div class="mb-3">
                            <label class="form-label" for="part-value">Example value</label>
                            <input id="part-value" class="form-control" @bind:get="EditedPart.Value"
                                   @bind:set="value => ExecuteEdit(() => EditedPart.Value = value ?? string.Empty)" />
                        </div>
                    }
			               <div class="row g-2 mb-3">
			                  <div class="col-6">
			                     <label for="part-width" class="form-label">Width (px)</label>
			                     <input id="part-width" class="form-control" type="number" @bind:get="EditedPart.Width" @bind:set="value => ExecuteEdit(() => EditedPart.Width = value)" />
			                  </div>
			                  <div class="col-6">
			                     <label for="part-height" class="form-label">Height (px)</label>
			                     <input id="part-height" class="form-control" type="number" @bind:get="EditedPart.Height" @bind:set="value => ExecuteEdit(() => EditedPart.Height = value)" />
			                  </div>
			               </div>
			               <div class="mb-3">
			                  <label for="part-tag" class="form-label">Tags</label>
			                  <div class="input-group">
			                     <select class="form-select" id="part-tag" @bind="selectedTag" disabled="@(AvailableTags.Count == 0)">
			                        <option value="">Select a tag</option>
			                        @foreach (var tag in AvailableTags)
			                        {
			                           <option value="@tag">@tag</option>
			                        }
			                     </select>
			                     <button type="button" class="btn btn-outline-primary" @onclick="() => ExecuteEdit(AddTag)" disabled="@string.IsNullOrWhiteSpace(selectedTag)">Add tag</button>
			                  </div>
			                  @if (EditedPart.Tags.Count > 0)
			                  {
			                     <div class="d-flex flex-wrap gap-2 mt-2">
			                        @foreach (var tag in EditedPart.Tags)
			                        {
			                           <span class="badge text-bg-secondary d-flex align-items-center gap-1">
			                              @tag
			                              <button type="button" class="btn-close btn-close-white" aria-label="Remove @tag tag" @onclick="() => ExecuteEdit(() => RemoveTag(tag))"></button>
			                           </span>
			                        }
			                     </div>
			                  }
			               </div>
			               <div class="mb-3">
			                  <label class="form-label">SVG background</label>
			                  <div class="d-flex flex-wrap gap-2">
			                     <label class="btn btn-outline-primary mb-0" for="part-svg-import">
			                        <i class="fa-solid fa-image me-1" aria-hidden="true"></i>Upload SVG
			                     </label>
			                     <InputFile id="part-svg-import" class="visually-hidden" accept="image/svg+xml,.svg" OnChange="ImportSvgAsync" />
			                     @if (!string.IsNullOrWhiteSpace(EditedPart.SvgMarkup))
			                     {
			                        <button type="button" class="btn btn-outline-danger" @onclick="() => ExecuteEdit(RemoveSvg)">Remove SVG</button>
			                     }
			                  </div>
			               </div>
			               @if (!string.IsNullOrWhiteSpace(EditedPart.SvgMarkup))
			               {
			                  <div class="row g-2 mb-3">
			                     <div class="col-6">
			                        <label class="form-label" for="svg-x">SVG X</label>
				                        <input id="svg-x" class="form-control" type="number" @bind:get="EditedPart.SvgLocalPosition.X" @bind:set="(float value) => ExecuteEdit(() => EditedPart.SvgLocalPosition = new Point(value, EditedPart.SvgLocalPosition.Y))" />
			                     </div>
			                     <div class="col-6">
			                        <label class="form-label" for="svg-y">SVG Y</label>
				                        <input id="svg-y" class="form-control" type="number" @bind:get="EditedPart.SvgLocalPosition.Y" @bind:set="(float value) => ExecuteEdit(() => EditedPart.SvgLocalPosition = new Point(EditedPart.SvgLocalPosition.X, value))" />
			                     </div>
			                  </div>
			                  <div class="mb-3">
			                     <label class="form-label" for="svg-rotation">SVG rotation (degrees)</label>
			                     <input id="svg-rotation" class="form-control" type="number" @bind:get="EditedPart.SvgRotation" @bind:set="value => ExecuteEdit(() => EditedPart.SvgRotation = value)" />
			                  </div>
			               }
			            </BootstrapTab>
			            <BootstrapTab Title="Points">
				            <div class="mb-1">
					            <div class="d-grid gap-2">
						            <button type="button" class="btn btn-primary" @onclick="() => ExecuteEdit(AddPoint)">Add connection point</button>
					            </div>
				            </div>

					            @if (SelectedPointInEditor is not null)
					            {
						            <div class="mt-3">
							            <label class="form-label" for="point-label">Point name</label>
							            <input id="point-label" class="form-control mb-3" @bind:get="SelectedPointInEditor.Label" @bind:set="value => ExecuteEdit(() => SelectedPointInEditor.Label = value ?? string.Empty)"/>
							            <div class="row g-2 mb-3">
								            <div class="col-6">
									            <label class="form-label" for="point-x">X</label>
								            <input id="point-x" class="form-control" type="number" @bind:get="SelectedPointInEditor.LocalPosition.X" @bind:set="(float value) => ExecuteEdit(() => SelectedPointInEditor.LocalPosition = new Point(value, SelectedPointInEditor.LocalPosition.Y))"/>
								            </div>
								            <div class="col-6">
									            <label class="form-label" for="point-y">Y</label>
								            <input id="point-y" class="form-control" type="number" @bind:get="SelectedPointInEditor.LocalPosition.Y" @bind:set="(float value) => ExecuteEdit(() => SelectedPointInEditor.LocalPosition = new Point(SelectedPointInEditor.LocalPosition.X, value))"/>
								            </div>
							            </div>
							            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => ExecuteEdit(RemoveSelectedPoint)">Delete selected Point</button>
							            </div>
					            }

			            </BootstrapTab>
			            <BootstrapTab Title="States" Disabled="@(!this.EditedPart.Points.Any())">

				            <div class="mb-1">
					            <div class="d-grid gap-2">
						            <button type="button" class="btn btn-primary" @onclick="() => ExecuteEdit(AddState)">Add state</button>
								</div>
				            </div>
					            @if (EditedPart.States.Count > 0) {
						            <div class="mt-3 p-3">
										<BootstrapTabs>
							            @foreach (PartState state in this.EditedPart.States)
							            {
							            <BootstrapTab @key="state" Title="@state.Label" OnClick="() => SelectActiveState(state)">
									            <label class="form-label" for="state-label">State name</label>
									            <input id="state-label" class="form-control mb-4" @bind:get="state.Label" @bind:set="value => ExecuteEdit(() => state.Label = value ?? string.Empty)"/>

									            <div class="d-grid gap-2">
										            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => ExecuteEdit(() => AddConnectionGroup(state))">Add group</button>
										            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => ExecuteEdit(() => RemoveState(state))">Remove state</button>
									            </div>

									            @if (state.ConnectionGroups.Count > 0 ){
										            <div class="p-3">
											            <BootstrapTabs>

												            @foreach (var group in state.ConnectionGroups.WithIndex())
												            {
																<BootstrapTab @key="group.Item" Title="@($"Group {group.Index}")">
														            <div class="m-2">
															            Connected:
															            @foreach (var connectedPin in group.Item.ConnectedPints)
															            {
																            <span class="badge text-bg-secondary">@connectedPin.Label</span>
															            }
														            </div>
														            <div class="d-flex flex-wrap gap-2">
															            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => ExecuteEdit(() => AddRemovePointToGroup(group.Item, SelectedPointInEditor))">Selected point to group</button>
															            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => ExecuteEdit(() => RemoveActiveConnectionGroup(group.Item))">Remove group</button>
														            </div>
													            </BootstrapTab>
												            }

											            </BootstrapTabs>
										            </div>
									            }
								            </BootstrapTab>
							            }
						            </BootstrapTabs>
						            </div>
					            }
			            </BootstrapTab>
		            </BootstrapTabs>




	            </section>


            </div>
        </aside>

        <section class="editor-canvas-panel" aria-label="SVG scheme"
                 @onpointermove="MoveDraggedItem"
                 @onpointerup="EndPointDrag"
                 @onpointercancel="CancelPointDrag"
                 @onpointerleave="EndPointDrag">
            <Gwire.Components.PartSvgBackground @key="EditedPart" @bind-Part="EditedPart"
                                                EditStarted="BeginEdit" EditCompleted="CompleteEdit" EditCanceled="CancelEdit">

                        @if (ActiveStateInEditor is { } state)
                        {
                            @foreach (var group in state.ConnectionGroups.WithIndex())
                            {
                                var points = group.Item.ConnectedPints;
                                @for (var firstIndex = 0; firstIndex < points.Count - 1; firstIndex++)
                                {
                                    @for (var secondIndex = firstIndex + 1; secondIndex < points.Count; secondIndex++)
                                    {
                                        <line x1="@points[firstIndex].LocalPosition.X" y1="@points[firstIndex].LocalPosition.Y" x2="@points[secondIndex].LocalPosition.X" y2="@points[secondIndex].LocalPosition.Y" class="connection-line-outline" />
                                        <line x1="@points[firstIndex].LocalPosition.X" y1="@points[firstIndex].LocalPosition.Y" x2="@points[secondIndex].LocalPosition.X" y2="@points[secondIndex].LocalPosition.Y" class="connection-line" style="stroke: @ConnectionGroup.GetLineColor(group.Index)" />
                                    }
                                }
                            }
                        }

                        @foreach (var point in EditedPart.Points)
                        {
                            <circle cx="@point.LocalPosition.X"
                                    cy="@point.LocalPosition.Y"
                                    r="10"
                                    class="@PointClass(point)"
                                    @onpointerdown="(eventArgs) => StartPointDrag(point, eventArgs)" />
                            <svg:text x="@(point.LocalPosition.X + 15)"
                                      y="@(point.LocalPosition.Y + 5)"
                                      class="point-label"
                                      @onpointerdown="(eventArgs) => StartPointDrag(point, eventArgs)">@point.Label</svg:text>
                        }

                @if (EditedPart.HasValue)
                {
                    <g class="part-value" @onpointerdown="StartValueDrag" @onpointerdown:stopPropagation="true">
                        <circle cx="@EditedPart.ValuePosition.X" cy="@EditedPart.ValuePosition.Y" r="7" class="value-handle">
                            <title>Drag to position the value</title>
                        </circle>
                        <svg:text x="@EditedPart.ValuePosition.X" y="@(EditedPart.ValuePosition.Y + 14)"
                                  text-anchor="middle" dominant-baseline="hanging" class="value-label">@EditedPart.Value</svg:text>
                    </g>
                }

            </Gwire.Components.PartSvgBackground>
        </section>
    </div>
</div>
