@page "/scheme-editor"
@using Gwire.Models
@inject Gwire.Services.GwirePartsService GwireParts

<PageTitle>Gwire - The scheme editor</PageTitle>

<div @ref="editorElement" class="scheme-editor" tabindex="0">
    <div class="scheme-editor-toolbar border-bottom bg-body-tertiary px-2 py-2" aria-label="Scheme editor toolbar">
        <button type="button" class="btn btn-sm btn-outline-primary me-2" @onclick="NewScheme" disabled="@history.IsFrozen">
            <i class="fa-solid fa-file-circle-plus me-1" aria-hidden="true"></i>New scheme
        </button>
        <label class="btn btn-sm btn-outline-primary me-2 mb-0 @(history.IsFrozen ? "disabled" : null)" for="scheme-import">
            <i class="fa-solid fa-file-import me-1" aria-hidden="true"></i>Import JSON
        </label>
        <InputFile id="scheme-import" class="visually-hidden" accept="application/json,.json" OnChange="ImportSchemeAsync" disabled="@history.IsFrozen" />
        <button type="button" class="btn btn-sm btn-outline-primary me-2" @onclick="ExportSchemeAsync" disabled="@history.IsFrozen">
            <i class="fa-solid fa-file-export me-1" aria-hidden="true"></i>Export JSON
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary me-2" data-scheme-pan-toggle
                aria-label="Pan mode" aria-pressed="false" title="Edit mode (hold Space to pan)">
            <i class="fa-solid fa-computer-mouse" aria-hidden="true"></i>
        </button>
        <div class="input-group input-group-sm scheme-editor-zoom me-2" role="group" aria-label="Zoom">
            <button type="button" class="btn btn-sm btn-outline-secondary" title="Zoom in" aria-label="Zoom in"
                    @onclick="() => SetZoomAsync(zoom + 0.1f)" disabled="@(zoom >= 2f || history.IsFrozen)">
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" title="Zoom out" aria-label="Zoom out"
                    @onclick="() => SetZoomAsync(zoom - 0.1f)" disabled="@(zoom <= 0.2f || history.IsFrozen)">
                <i class="fa-solid fa-minus" aria-hidden="true"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" title="Reset zoom to 100%" aria-label="Reset zoom to 100%"
                    @onclick="() => SetZoomAsync(1f)" disabled="@history.IsFrozen">100%</button>
            <input type="number" class="form-control text-center" min="20" max="200" step="1" inputmode="numeric"
                   aria-label="Zoom percentage" @bind:get="ZoomPercentage" @bind:set="SetZoomPercentageAsync"
                   disabled="@history.IsFrozen" />
        </div>
        <div class="btn-group btn-group-sm me-2" role="group" aria-label="Edit history">
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="history.Undo" disabled="@(!history.CanUndo)">
                <i class="fa-solid fa-rotate-left me-1" aria-hidden="true"></i>Undo
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="history.Redo" disabled="@(!history.CanRedo)">
                <i class="fa-solid fa-rotate-right me-1" aria-hidden="true"></i>Redo
            </button>
        </div>
        <button type="button" class="btn btn-sm btn-outline-danger me-2" @onclick="DeleteSelectedPart"
                disabled="@(SelectedPart is null || history.IsFrozen)">
            <i class="fa-solid fa-trash me-1" aria-hidden="true"></i>Delete selected
        </button>
        <button type="button" class="btn btn-sm btn-primary" @onclick="AddCable" disabled="@history.IsFrozen">
            <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Add cable
        </button>
        <div class="input-group input-group-sm scheme-editor-part-picker">
            <select class="form-select" aria-label="Part to add" @bind="selectedPartForAddIndex" disabled="@(GwireParts.Parts.Count == 0)">
                <option value="-1">Select a part</option>
                @foreach (var (part, index) in GwireParts.Parts.Select((part, index) => (part, index)))
                {
                    <option value="@index">@part.DisplayName</option>
                }
            </select>
            <button type="button" class="btn btn-sm btn-primary" @onclick="AddSelectedPart" disabled="@(selectedPartForAddIndex < 0 || history.IsFrozen)">
                <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Add</button>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary ms-2" @onclick="ToggleDetails"
                aria-expanded="@(showDetails ? "true" : "false")" aria-controls="scheme-editor-details">
            <i class="fa-solid fa-circle-info me-1" aria-hidden="true"></i>Details
        </button>
        <div class="d-flex flex-wrap align-items-center gap-2 mt-2" role="group" aria-label="Source-ground pairs">
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddSourceGroundPair" disabled="@history.IsFrozen">
                <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Add source-ground pair
            </button>
            @foreach (var (pair, index) in SourceGroundPairs.Select((pair, index) => (pair, index)))
            {
                <label @key="pair" class="d-flex align-items-center gap-2">
                    Pair @(index + 1)
                    <input type="color" class="form-control form-control-color" title="Path color"
                           aria-label="@($"Path color for pair {index + 1}")"
                           @bind:get="pair.LineColor" @bind:set="color => SetPairColor(pair, color)" disabled="@history.IsFrozen" />
                </label>
            }
        </div>
    </div>

    <div class="scheme-editor-content">
        @if (showDetails)
        {
            <aside id="scheme-editor-details" class="scheme-editor-details" aria-label="Circuit details">
                <section class="card shadow-sm p-2">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h2 class="h6 mb-0">Circuit details</h2>
                        <button type="button" class="btn-close" aria-label="Close details" @onclick="ToggleDetails"></button>
                    </div>
                    <div class="mb-3">
                        <label for="circuit-name" class="form-label">Name</label>
                        <input id="circuit-name" class="form-control" @bind:get="Circuit.Name" @bind:set="value => Circuit.Name = value ?? string.Empty" />
                    </div>
                    <div class="mb-3">
                        <label for="circuit-description" class="form-label">Description</label>
                        <textarea id="circuit-description" class="form-control" rows="3" @bind:get="Circuit.Description" @bind:set="value => Circuit.Description = value ?? string.Empty"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="circuit-tag" class="form-label">Tags</label>
                        <div class="input-group">
                            <select id="circuit-tag" class="form-select" @bind="selectedTag" disabled="@(AvailableTags.Count == 0)">
                                <option value="">Select a tag</option>
                                @foreach (var tag in AvailableTags)
                                {
                                    <option value="@tag">@tag</option>
                                }
                            </select>
                            <button type="button" class="btn btn-outline-primary" @onclick="AddTag" disabled="@string.IsNullOrWhiteSpace(selectedTag)">Add tag</button>
                        </div>
                        @if (Circuit.Tags.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                @foreach (var tag in Circuit.Tags)
                                {
                                    <span class="badge text-bg-secondary d-flex align-items-center gap-1">
                                        @tag
                                        <button type="button" class="btn-close btn-close-white" aria-label="Remove @tag tag" @onclick="() => RemoveTag(tag)"></button>
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </section>
            </aside>
        }

        <div class="scheme-editor-canvas-container">
            <svg class="scheme-editor-canvas"
                 role="img"
                 aria-label="Circuit scheme editor"
                 @onclick="ClearSelection">
                <defs>
                    <pattern id="scheme-grid" width="25" height="25" patternUnits="userSpaceOnUse">
                        <path d="M 25 0 L 0 0 0 25" fill="none" class="scheme-grid" />
                    </pattern>
                </defs>
                <rect width="100%" height="100%" fill="url(#scheme-grid)" />
                @foreach (var part in Circuit.Parts.OfType<CircuitPart>().OrderBy(part => ReferenceEquals(part, SelectedPart)))
                {
                    <CircuitPartRenderer @key="part" CircuitPart="part" Zoom="zoom"
                        OnDelete="() => DeletePart(part)" 
                        OnEditText="value => editedTextPart = value"
                                         @bind-IsSelected:get="ReferenceEquals(part, SelectedPart)"
                                         @bind-IsSelected:set="value => SetPartSelection(part, value)" />
                }
                @foreach (var cable in Circuit.Parts.OfType<CablePart>().OrderBy(cable => ReferenceEquals(cable, SelectedPart)))
                {
                    <CablePartRenderer @key="cable" CablePart="cable" Circuit="Circuit" Zoom="zoom"
                    OnDelete="() => DeletePart(cable)"
                                       @bind-IsSelected:get="ReferenceEquals(cable, SelectedPart)"
                                       @bind-IsSelected:set="value => SetPartSelection(cable, value)" />
                }
                @foreach (var pair in SourceGroundPairs)
                {
                    <CircuitTerminalRenderer @key="pair.PowerSource" CircuitPart="pair.PowerSource" Pair="pair" Circuit="Circuit" SourceGroundPairs="SourceGroundPairs" Zoom="zoom" />
                    <CircuitTerminalRenderer @key="pair.Ground" CircuitPart="pair.Ground" Pair="pair" Circuit="Circuit" SourceGroundPairs="SourceGroundPairs" Zoom="zoom" />
                }
                <CircuitPathRenderer Circuit="Circuit" SourceGroundPairs="SourceGroundPairs" />
            </svg>
        </div>
    </div>
</div>

<PartTextModal @bind-Part="editedTextPart" />
