@page "/scheme-editor"
@using Gwire.Models
@using Gwire.Models.Base
@inject Gwire.Services.GwirePartsService GwireParts

<PageTitle>Gwire - The scheme editor</PageTitle>

<div class="scheme-editor">
    <div class="scheme-editor-toolbar border-bottom bg-body-tertiary px-2 py-2" aria-label="Scheme editor toolbar">
        <button type="button" class="btn btn-primary" @onclick="AddCable">
            <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Add cable
        </button>
        <div class="input-group scheme-editor-part-picker">
            <select class="form-select" aria-label="Part to add" @bind="selectedPartIndex" disabled="@(GwireParts.Parts.Count == 0)">
                <option value="-1">Select a part</option>
                @for (var index = 0; index < GwireParts.Parts.Count; index++)
                {
                    <option value="@index">@(GwireParts.Parts[index] is CircuitPart part ? part.DisplayName : GwireParts.Parts[index].Name)</option>
                }
            </select>
            <button type="button" class="btn btn-primary" @onclick="AddSelectedPart" disabled="@(selectedPartIndex < 0)">
                <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Add</button>
        </div>
    </div>

    <div class="scheme-editor-canvas-container">
        <svg class="scheme-editor-canvas"
             viewBox="0 0 1200 700"
             role="img"
             aria-label="Circuit scheme editor"
             @onpointermove="MoveDraggedItem"
             @onpointerup="EndDrag"
             @onpointercancel="CancelDrag"
             @onpointerleave="CancelDrag">
            <defs>
                <pattern id="scheme-grid" width="25" height="25" patternUnits="userSpaceOnUse">
                    <path d="M 25 0 L 0 0 0 25" fill="none" class="scheme-grid" />
                </pattern>
            </defs>
            <rect width="1200" height="700" fill="url(#scheme-grid)" />

            @foreach (var cable in Circuit.Parts.OfType<CablePart>())
            {
                <line x1="@cable.Points[0].LocalX"
                      y1="@cable.Points[0].LocalY"
                      x2="@cable.Points[1].LocalX"
                      y2="@cable.Points[1].LocalY"
                      class="cable-line" />
            }

            @foreach (var part in Circuit.Parts.OfType<CircuitPart>())
            {
                <g transform="@PartTransform(part)" @onpointerdown="(eventArgs) => StartPartDrag(part, eventArgs)">
                    @if (SvgImageSource(part) is { } svgImageSource)
                    {
                        <svg x="0" y="0" width="@part.Width" height="@part.Height" overflow="hidden">
                            <image href="@svgImageSource"
                                   x="@part.SvgLocalX"
                                   y="@part.SvgLocalY"
                                   width="@part.Width"
                                   height="@part.Height"
                                   preserveAspectRatio="xMidYMid meet"
                                   class="scheme-part-svg" />
                        </svg>
                    }
                </g>
            }

            @foreach (var part in Circuit.Parts.OfType<CircuitPart>())
            {
                <g transform="@PartTransform(part)" class="scheme-part-points" @onpointerdown="(eventArgs) => StartPartDrag(part, eventArgs)">
                    @foreach (var point in part.Points)
                    {
                        <circle cx="@point.LocalX" cy="@point.LocalY" r="10" class="scheme-connection-point" />
                    }
                </g>
            }

            @foreach (var cable in Circuit.Parts.OfType<CablePart>())
            {
                @foreach (var point in cable.Points)
                {
                    <circle cx="@point.LocalX"
                            cy="@point.LocalY"
                            r="10"
                            class="scheme-connection-point cable-endpoint"
                            @onpointerdown="(eventArgs) => StartCablePointDrag(point, eventArgs)" />
                }
            }
        </svg>
    </div>
</div>
