@page "/scheme-editor"
@using Gwire.Models
@using Gwire.Components.SearchDialog
@using Microsoft.AspNetCore.Components.Sections
@inject Gwire.Services.GwirePartsService GwireParts

<PageTitle>Gwire - The scheme editor</PageTitle>

<SectionContent SectionName="editor-toolbar">
    <div class="scheme-editor-toolbar" aria-label="Scheme editor toolbar">
        <div class="scheme-editor-toolbar-actions">
            <div class="input-group input-group-sm scheme-editor-zoom me-2" role="group" aria-label="Zoom">
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="NewScheme" disabled="@history.IsFrozen" title="New scheme" aria-label="New scheme">
                    <i class="fa-solid fa-file-circle-plus" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="SearchSchemesAsync"
                        disabled="@(GwireParts.Schemes.Count == 0 || history.IsFrozen || SchemeSearchIsShown)" 
                        title="Get scheme from repo" aria-label="Get scheme from repo">
                    <i class="fa-solid fa-cloud-arrow-down"  aria-hidden="true"></i>
                </button>
                <label class="btn btn-sm btn-outline-primary @(history.IsFrozen ? "disabled" : null)" for="scheme-import" title="Import JSON" aria-label="Import JSON">
                    <i class="fa-solid fa-file-import" aria-hidden="true"></i>
                </label>
                <InputFile id="scheme-import" class="visually-hidden" accept="application/json,.json" OnChange="ImportSchemeAsync" disabled="@history.IsFrozen" />
                <button type="button" class="btn btn-sm btn-outline-primary " @onclick="ExportSchemeAsync" disabled="@history.IsFrozen" title="Export JSON" aria-label="Export JSON">
                    <i class="fa-solid fa-file-export" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ExportPdfAsync"
                        disabled="@(history.IsFrozen || Circuit.Parts.Count == 0)" title="Export PDF" aria-label="Export PDF">
                    <i class="fa-solid fa-file-pdf" aria-hidden="true"></i>
                </button>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary me-2" id="scheme-pan-toggle"
                    aria-label="Pan mode" aria-pressed="false" title="Edit mode (hold Space to pan)">
                <i class="fa-solid fa-computer-mouse" aria-hidden="true"></i>
            </button>
            <div class="input-group input-group-sm scheme-editor-zoom position-fixed bottom-0 end-0 m-3 z-3" role="group" aria-label="Zoom">
                <button type="button" class="btn btn-sm btn-outline-secondary" title="Zoom in" aria-label="Zoom in"
                        @onclick="() => SetZoomAsync(zoom + 0.1f)" disabled="@(zoom >= 2f || history.IsFrozen)">
                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" title="Zoom out" aria-label="Zoom out"
                        @onclick="() => SetZoomAsync(zoom - 0.1f)" disabled="@(zoom <= 0.2f || history.IsFrozen)">
                    <i class="fa-solid fa-minus" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" title="Reset zoom to 100%" aria-label="Reset zoom to 100%"
                        @onclick="() => SetZoomAsync(1f)" disabled="@history.IsFrozen">
                    <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
                </button>
                <input type="number" class="form-control text-center" min="20" max="200" step="1" inputmode="numeric"
                       aria-label="Zoom percentage" @bind:get="ZoomPercentage" @bind:set="SetZoomPercentageAsync"
                       disabled="@history.IsFrozen" />
            </div>
            <div class="btn-group btn-group-sm me-2" role="group" aria-label="Edit history">
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="history.Undo" disabled="@(!history.CanUndo)" title="Undo" aria-label="Undo">
                    <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="history.Redo" disabled="@(!history.CanRedo)" title="Redo" aria-label="Redo">
                    <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2" role="group" aria-label="Source-ground pairs">
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ToggleDetails"
                    aria-expanded="@(showDetails ? "true" : "false")" aria-controls="scheme-editor-details" title="Details" aria-label="Details">
                <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
            </button>
            <div class="btn-group btn-group-sm" role="group" aria-label="Add parts">
                <button type="button" class="btn btn-sm btn-primary" @onclick="AddCable" disabled="@history.IsFrozen" title="Add cable" aria-label="Add cable">
                    <span class="add-cable-icon" aria-hidden="true">
                        <i class="fa-solid fa-plug"></i>
                        <i class="fa-solid fa-plus add-cable-plus"></i>
                    </span>
                </button>
                <button type="button" class="btn btn-sm btn-primary" @onclick="SearchPartsAsync"
                        disabled="@(GwireParts.Parts.Count == 0 || history.IsFrozen || PartSearchIsShown)" title="Add part" aria-label="Add part">
                    <span class="add-part-icon" aria-hidden="true">
                        <i class="fa-solid fa-microchip"></i>
                        <i class="fa-solid fa-plus add-part-plus"></i>
                    </span>
                </button>
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary @(showSourceGroundPair ? "active" : null)"
                    @onclick="ToggleSourceGroundPair" disabled="@history.IsFrozen"
                    aria-pressed="@(showSourceGroundPair ? "true" : "false")"
                    title="@(showSourceGroundPair ? "Hide measurement pair" : "Show measurement pair")"
                    aria-label="@(showSourceGroundPair ? "Hide measurement pair" : "Show measurement pair")">
                <i class="fa-solid fa-bolt" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</SectionContent>

<div @ref="editorElement" class="scheme-editor" tabindex="0">
    <div class="scheme-editor-content">
        @if (showDetails)
        {
            <aside id="scheme-editor-details" class="scheme-editor-details" aria-label="Circuit details">
                <section class="card shadow-sm p-2">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h2 class="h6 mb-0">Circuit details</h2>
                        <button type="button" class="btn-close" aria-label="Close details" @onclick="ToggleDetails"></button>
                    </div>
                    <div class="mb-3">
                        <label for="circuit-name" class="form-label">Name</label>
                        <input id="circuit-name" class="form-control" @bind:get="Circuit.Name" @bind:set="value => Circuit.Name = value ?? string.Empty" />
                    </div>
                    <div class="mb-3">
                        <label for="circuit-description" class="form-label">Description</label>
                        <textarea id="circuit-description" class="form-control" rows="3" @bind:get="Circuit.Description" @bind:set="value => Circuit.Description = value ?? string.Empty"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="circuit-tag" class="form-label">Tags</label>
                        @if (Circuit.Tags.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                @foreach (var tag in Circuit.Tags)
                                {
                                    <span class="badge text-bg-secondary d-flex align-items-center gap-1">
                                        @tag
                                        <button type="button" class="btn-close btn-close-white" aria-label="Remove @tag tag" @onclick="() => RemoveTag(tag)"></button>
                                    </span>
                                }
                            </div>
                        }
                        <div class="position-relative" @onkeydown="HandleTagKeyDown">
                            <input class="form-control" id="circuit-tag" placeholder="Search existing tags" autocomplete="off"
                                   role="combobox" aria-autocomplete="list" aria-controls="circuit-tag-options"
                                   aria-expanded="@(showTagSuggestions && TagSuggestions.Count > 0 ? "true" : "false")"
                                   aria-activedescendant="@(showTagSuggestions && TagSuggestions.Count > 0 ? $"circuit-tag-option-{activeTagSuggestionIndex}" : null)"
                                   @bind="selectedTag" @bind:event="oninput" @bind:after="ResetTagSuggestions"
                                   @onfocus="ResetTagSuggestions" @onblur="CloseTagSuggestions"
                                   onkeydown="if (['ArrowDown', 'ArrowUp', 'Enter'].includes(event.key)) event.preventDefault();"
                                   disabled="@(AvailableTags.Count == 0)" />
                            @if (showTagSuggestions)
                            {
                                var suggestions = TagSuggestions;
                                <div id="circuit-tag-options" class="tag-suggestions list-group shadow-sm" role="listbox" aria-label="Existing tags">
                                    @for (var index = 0; index < suggestions.Count; index++)
                                    {
                                        var suggestionIndex = index;
                                        var tag = suggestions[index];
                                        <button type="button" id="circuit-tag-option-@index" tabindex="-1" role="option"
                                                class="list-group-item list-group-item-action @(index == activeTagSuggestionIndex ? "active" : null)"
                                                aria-selected="@(index == activeTagSuggestionIndex ? "true" : "false")"
                                                @onmousedown:preventDefault="true"
                                                @onmouseover="() => activeTagSuggestionIndex = suggestionIndex"
                                                @onclick="() => AddTag(tag)">@tag</button>
                                    }
                                    @if (suggestions.Count == 0)
                                    {
                                        <div class="list-group-item text-body-secondary" role="status">No matching tags.</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </section>
            </aside>
        }

        <div class="scheme-editor-canvas-container">
            <svg class="scheme-editor-canvas"
                 role="img"
                 aria-label="Circuit scheme editor"
                 @onclick="ClearSelection">
                <defs>
                    <pattern id="scheme-grid" width="25" height="25" patternUnits="userSpaceOnUse">
                        <path d="M 25 0 L 0 0 0 25" fill="none" class="scheme-grid" />
                    </pattern>
                </defs>
                <rect id="scheme-editor-background" width="100%" height="100%" fill="url(#scheme-grid)" />
                <g data-pdf-content>
                    @foreach (var part in Circuit.Parts.OfType<CircuitPart>().OrderBy(part => ReferenceEquals(part, SelectedPart)))
                    {
                        <CircuitPartRenderer @key="part" CircuitPart="part" Zoom="zoom"
                            OnDelete="() => DeletePart(part)"
                            OnEditText="value => editedTextPart = value"
                                             @bind-IsSelected:get="ReferenceEquals(part, SelectedPart)"
                                             @bind-IsSelected:set="value => SetPartSelection(part, value)" />
                    }
                    @foreach (var cable in Circuit.Parts.OfType<CablePart>().OrderBy(cable => ReferenceEquals(cable, SelectedPart)))
                    {
                        <CablePartRenderer @key="cable" CablePart="cable" Circuit="Circuit" Zoom="zoom"
                        OnDelete="() => DeletePart(cable)"
                                           @bind-IsSelected:get="ReferenceEquals(cable, SelectedPart)"
                                           @bind-IsSelected:set="value => SetPartSelection(cable, value)" />
                    }
                </g>
                @if (showSourceGroundPair)
                {
                    @foreach (var pair in SourceGroundPairs)
                    {
                        <CircuitTerminalRenderer @key="pair.PowerSource" CircuitPart="pair.PowerSource" Pair="pair" Circuit="Circuit" SourceGroundPairs="SourceGroundPairs" Zoom="zoom" />
                        <CircuitTerminalRenderer @key="pair.Ground" CircuitPart="pair.Ground" Pair="pair" Circuit="Circuit" SourceGroundPairs="SourceGroundPairs" Zoom="zoom" />
                    }
                    <CircuitPathRenderer Circuit="Circuit" SourceGroundPairs="SourceGroundPairs" />
                }
                <SectionOutlet SectionName="svg-context-menu" />
            </svg>
        </div>
    </div>
</div>

@if (SelectedPart is null)
{
    <SvgContextMenu Target="#scheme-editor-background">
        <SvgContextMenuItem OnClick="SearchPartsAsync" Disabled="@(history.IsFrozen || GwireParts.Parts.Count == 0 || PartSearchIsShown)">
            Add part
        </SvgContextMenuItem>
        <SvgContextMenuItem OnClick="AddCable" Disabled="@history.IsFrozen">
            Add cable
        </SvgContextMenuItem>
        <SvgContextMenuItem OnClick="ToggleSourceGroundPair" Disabled="@history.IsFrozen">
            @(showSourceGroundPair ? "Hide measurement pair" : "Show measurement pair")
        </SvgContextMenuItem>
    </SvgContextMenu>
}

<div @ref="pdfExportModal" class="modal" tabindex="-1" aria-labelledby="pdf-export-title" aria-describedby="pdf-export-description">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content" aria-busy="true">
            <div class="modal-body text-center py-4" role="status">
                <div class="spinner-border text-primary mb-3" aria-hidden="true"></div>
                <h2 class="h5" id="pdf-export-title">@(isLoadingScheme ? "Loading scheme…" : "Exporting PDF…")</h2>
                <p class="mb-0 text-body-secondary" id="pdf-export-description">@(isLoadingScheme ? "Please wait while the selected scheme is being loaded from the repository." : "Please wait while your PDF is being prepared.")</p>
            </div>
        </div>
    </div>
</div>

<PartTextModal @bind-Part="editedTextPart" />

<SearchDialog Options="partSearchOptions" @bind-Visible="PartSearchIsShown" />

<SearchDialog Options="schemeSearchOptions" @bind-Visible="SchemeSearchIsShown" />
