<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        @{ 
            var pageRouteData = ResolvePageRouteData(routeData); 
        }
        <RouteView RouteData="@pageRouteData" DefaultLayout="@typeof(MainLayout)"/>
        <FocusOnNavigate RouteData="@pageRouteData" Selector="h1" />
    </Found>
</Router>
