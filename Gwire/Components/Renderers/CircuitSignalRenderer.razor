@foreach (var connection in connections)
{
    @for (var coilIndex = 0; coilIndex < connection.Coils.Count; coilIndex++)
    {
        var coil = connection.Coils[coilIndex];
        var coilOffset = (coilIndex - (connection.Coils.Count - 1) / 2f) * SignalSpacing;
        <g aria-label="@($"{coil.Name}: bass to treble")">
            @for (var step = 0; step < GradientSteps; step++)
            {
                var offset = coilOffset + ((step + 0.5f) / GradientSteps - 0.5f) * SignalWidth;
                var path = SignalPathGeometry.GetPath(connection.From, connection.To, offset);
                @if (path.Length > 0)
                {
                    <path d="@path" class="signal-band" stroke-width="@GradientStrokeWidth"
                          style="stroke: @GetGradientColor(coil.Color, step)" />
                }
            }
            @{ var flowPath = SignalPathGeometry.GetPath(connection.From, connection.To, coilOffset); }
            @if (flowPath.Length > 0)
            {
                <path d="@flowPath" class="signal-band signal-flow" stroke-width="@SignalWidth"
                      aria-hidden="true" />
            }
        </g>
    }
}
