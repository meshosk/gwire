<CascadingValue Value="trace">
    @ChildContent
</CascadingValue>

@foreach (var connection in connections)
{
    var coils = connection.Coils;
    @for (var coilIndex = 0; coilIndex < coils.Count; coilIndex++)
    {
        var coil = coils[coilIndex];
        var flowClass = connection.ReverseFlow.Contains(coil) ? "signal-flow signal-flow-reversed" : "signal-flow";
        var coilOffset = (coilIndex - (coils.Count - 1) / 2f) * SignalSpacing;
        var signalWidth = GetFlowWidth(connection, coil);
        <g aria-label="@($"{coil.Name}: bass to treble")">
            @foreach (var band in GetBands(connection, coil, coilOffset))
            {
                <path d="@band.Path" class="signal-band" stroke-width="@GradientStrokeWidth(band.Width)"
                      style="stroke: @GetGradientColor(coil.Color, band.Step)" />
            }
            @{ var flowPath = SignalPathGeometry.GetPath(connection.From, connection.To, coilOffset); }
            @if (flowPath.Length > 0 && signalWidth > 0)
            {
                <path d="@flowPath" class="signal-band @flowClass" stroke-width="@signalWidth.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                      aria-hidden="true" />
            }
        </g>
    }
}
