@foreach (var pair in SourceGroundPairs)
{
    <g @key="pair" stroke="@pair.LineColor" aria-label="Connections reachable from power source">
        @foreach (var points in GetPathPoints(pair))
        {
            <polyline points="@points" class="circuit-path" />
        }
    </g>
}

@foreach (var pair in SourceGroundPairs)
{
    @if (GetShortCircuitPathPoints(pair) is { } points)
    {
        <g @key="pair.Ground" aria-hidden="true">
            <polyline points="@points" stroke="@pair.LineColor" class="circuit-path circuit-short-outline" />
            <polyline points="@points" stroke="@GetInvertedColor(pair.LineColor)" class="circuit-path" />
        </g>
    }
}
