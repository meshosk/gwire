<g id="@elementReferenceId" @ref="element" transform="@PartTransform"
   @onclick="Select"
   @oncontextmenu="SelectContextTarget"
   @oncontextmenu:stopPropagation="true"
   @onclick:stopPropagation="true"
   @onpointerdown="StartDrag"
   @onpointermove="MoveDraggedPart"
   @onpointerup="EndDrag"
   @onpointercancel="CancelDrag"
   @onpointerdown:stopPropagation="true">
   
    @if (SvgImageSource is { } svgImageSource)
    {
        <svg x="@CircuitPart.SvgLocalPosition.X" y="@CircuitPart.SvgLocalPosition.Y" width="@CircuitPart.Width" height="@CircuitPart.Height" overflow="hidden" class="circuit-part-svg">
            <SvgBackground Source="@svgImageSource" Width="CircuitPart.Width" Height="CircuitPart.Height" Rotation="CircuitPart.SvgRotation" />
        </svg>
    }

    @if (CircuitPart.CustomTextValue is not null)
    {
        <svg:text x="@CircuitPart.ValuePosition.X" y="@(CircuitPart.ValuePosition.Y + 14)"
                  text-anchor="middle" dominant-baseline="hanging" class="circuit-part-value">@CircuitPart.CustomTextValue</svg:text>
    }

    <g class="circuit-part-points">
        @foreach (var point in CircuitPart.Points)
        {
            <circle cx="@point.LocalPosition.X"
                    cy="@point.LocalPosition.Y"
                    r="10"
                    class="circuit-connection-point @(point.IsHighlighted ? "connection-highlight" : null)" />
        }
    </g>
    @if (IsSelected)
    {
        <rect x="@CircuitPart.SvgLocalPosition.X" y="@CircuitPart.SvgLocalPosition.Y" width="@CircuitPart.Width" height="@CircuitPart.Height"
              class="circuit-selection-outline" />
    }
</g>

@if (OnDelete.HasDelegate || OnDuplicate.HasDelegate || CircuitPart.States.Count > 1 || (CircuitPart.CustomTextValue is not null && OnEditText.HasDelegate))
{
    <SvgContextMenu Target="@("#" + elementReferenceId)">
        @if (CircuitPart.States.Count > 1)
        {
            <SvgContextSubmenu Label="State" Disabled="@History.IsFrozen">
                @foreach (var state in CircuitPart.States)
                {
                    <SvgContextMenuItem @key="state" OnClick="() => SetActiveState(state)" Disabled="@History.IsFrozen"
                                        IsChecked="@ReferenceEquals(CircuitPart.ActiveState, state)">
                        @state.Label
                    </SvgContextMenuItem>
                }
            </SvgContextSubmenu>
        }
        @if (CircuitPart.CustomTextValue is not null && OnEditText.HasDelegate)
        {
            <SvgContextMenuItem OnClick="() => OnEditText.InvokeAsync(CircuitPart)" Disabled="@History.IsFrozen">
                Edit text…
            </SvgContextMenuItem>
        }
        @if (OnDuplicate.HasDelegate)
        {
            <SvgContextMenuItem OnClick="() => OnDuplicate.InvokeAsync()" Disabled="@History.IsFrozen">
                Duplicate
            </SvgContextMenuItem>
        }
        @if (OnDelete.HasDelegate)
        {
            <SvgContextMenuItem OnClick="() => OnDelete.InvokeAsync()" Disabled="@History.IsFrozen">
                Delete
            </SvgContextMenuItem>
        }
    </SvgContextMenu>
}
