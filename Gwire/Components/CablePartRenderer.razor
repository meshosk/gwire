<g @ref="element"
   @onpointermove="MoveDraggedPoint"
   @onpointerup="EndDrag"
   @onpointercancel="CancelDrag">
    <line x1="@CablePart.Points[0].LocalPosition.X"
          y1="@CablePart.Points[0].LocalPosition.Y"
          x2="@CablePart.Points[1].LocalPosition.X"
          y2="@CablePart.Points[1].LocalPosition.Y"
          class="cable-line" />

    @foreach (var point in CablePart.Points)
    {
        <circle cx="@point.LocalPosition.X"
                cy="@point.LocalPosition.Y"
                r="10"
                class="cable-connection-point cable-endpoint @(point.IsHighlighted ? "connection-highlight" : null)"
                @onpointerdown="(eventArgs) => StartDrag(point, eventArgs)"
                @onpointerdown:stopPropagation="true" />
    }
</g>
