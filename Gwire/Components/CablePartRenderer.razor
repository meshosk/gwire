<g id="@elementReferenceId" @ref="elementReference"
   @onclick="Select"
   @oncontextmenu="SelectContextTarget"
   @oncontextmenu:stopPropagation="true"
   @onclick:stopPropagation="true"
   @onpointerdown="PrepareSelection"
   @onpointermove="MoveDraggedPoint"
   @onpointerup="EndDrag"
   @onpointercancel="CancelDrag">
    <polyline points="@CablePath"
              class="cable-line @(IsSelected ? "cable-selected" : null)" />

    <CableBendPoints CablePart="CablePart" History="History" IsSelected="IsSelected" />

    @foreach (var point in CablePart.Points)
    {
        <circle cx="@point.LocalPosition.X"
                cy="@point.LocalPosition.Y"
                r="10"
                class="cable-connection-point cable-endpoint @(IsSelected ? "cable-selected" : null) @(point.IsHighlighted ? "connection-highlight" : null)"
                @onpointerdown="(eventArgs) => StartDrag(point, eventArgs)"
                @onpointerdown:stopPropagation="true" />
    }
</g>

<SvgContextMenu Target="@("#" + elementReferenceId)">
    <SvgContextMenuItem OnClick="AddBendPoint" CanExecute="CanAddBendPoint">
        Add bend point
    </SvgContextMenuItem>
</SvgContextMenu>
