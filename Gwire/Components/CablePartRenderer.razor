<g id="@elementReferenceId" @ref="elementReference"
   @onclick="Select"
   @oncontextmenu="SelectContextTarget"
   @oncontextmenu:stopPropagation="true"
   @onclick:stopPropagation="true"
   @onpointerdown="PrepareSelection"
   @onpointermove="MoveDraggedPoint"
   @onpointerup="EndDrag"
   @onpointercancel="CancelDrag">
    @if (IsSelected)
    {
        <polyline points="@CablePath" class="cable-line cable-selection-outline" aria-hidden="true" />
    }
    <polyline points="@CablePath" stroke="@CablePart.Color" class="cable-line" />

    <CableBendPoints CablePart="CablePart" IsSelected="IsSelected" Zoom="Zoom" />

    @foreach (var point in CablePart.Points)
    {
        <circle cx="@point.LocalPosition.X"
                cy="@point.LocalPosition.Y"
                r="10"
                class="cable-connection-point cable-endpoint @(IsSelected ? "cable-selected" : null) @(point.IsHighlighted ? "connection-highlight" : null)"
                @onpointerdown="(eventArgs) => StartDrag(point, eventArgs)"
                @onpointerdown:stopPropagation="true" />
    }
</g>

<SvgContextMenu Target="@("#" + elementReferenceId)">
    <label class="dropdown-item d-flex align-items-center justify-content-between gap-2">
        Color
        <input type="color" class="form-control form-control-color" aria-label="Cable color"
               @bind:get="CablePart.Color" @bind:set="ChangeColor" disabled="@History.IsFrozen" />
    </label>
    <SvgContextMenuItem OnClick="AddBendPoint" CanExecute="CanAddBendPoint">
        Add bend point
    </SvgContextMenuItem>
    <SvgContextMenuItem OnClick="() => OnDelete.InvokeAsync()" Disabled="@History.IsFrozen">
        Delete
    </SvgContextMenuItem>
</SvgContextMenu>
