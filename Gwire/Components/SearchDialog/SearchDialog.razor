<div @ref="modalElement" class="modal fade" tabindex="-1" aria-labelledby="@titleId">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="@titleId">@Options.Title</h5>
                <button type="button" class="btn-close" aria-label="Close" @onclick="CancelAsync" disabled="@responding"></button>
            </div>
            <div class="modal-body">
                <div class="list-group mb-3" aria-label="Search results" aria-live="polite">
                    @foreach (var match in results)
                    {
                        <div class="list-group-item d-flex align-items-center justify-content-between gap-2">
                            <span class="search-result-text">@match.Text</span>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => SelectAsync(match)" disabled="@responding">Select</button>
                        </div>
                    }
                    @if (results.Count == 0)
                    {
                        <div class="list-group-item text-body-secondary">No matching items.</div>
                    }
                </div>
                @if (Options.Tags.Count > 0 || Options.TextTerms.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-2 mb-2" aria-label="Search filters">
                        @foreach (var tag in Options.Tags)
                        {
                            <span class="badge text-bg-secondary d-flex align-items-center gap-1">
                                @tag
                                <button type="button" class="btn-close btn-close-white" aria-label="Remove @tag tag" @onclick="() => RemoveTag(tag)" disabled="@responding"></button>
                            </span>
                        }
                        @foreach (var term in Options.TextTerms)
                        {
                            <span class="badge text-bg-primary d-flex align-items-center gap-1">
                                @term
                                <button type="button" class="btn-close btn-close-white" aria-label="Remove @term text filter" @onclick="() => RemoveTextTerm(term)" disabled="@responding"></button>
                            </span>
                        }
                    </div>
                }
                <label for="@inputId" class="form-label">Search</label>
                <div class="position-relative" onkeydown="if (event.target.tagName === 'INPUT' && ['ArrowDown', 'ArrowUp', 'Enter'].includes(event.key)) event.preventDefault();">
                    <input id="@inputId" class="form-control" placeholder="Enter text or #tag" autocomplete="off"
                           role="combobox" aria-autocomplete="list" aria-controls="@suggestionsId"
                           aria-expanded="@(showTagSuggestions ? "true" : "false")"
                           aria-activedescendant="@(showTagSuggestions && TagSuggestions.Count > 0 ? $"{suggestionsId}-{activeTagSuggestionIndex}" : null)"
                           @bind="draftValue" @bind:event="oninput" @bind:after="ResetTagSuggestions"
                           @onfocus="ResetTagSuggestions" @onblur="CloseTagSuggestions" @onkeydown="HandleKeyDown"
                           disabled="@responding" />
                    @if (showTagSuggestions)
                    {
                        var suggestions = TagSuggestions;
                        <div id="@suggestionsId" class="tag-suggestions list-group shadow-sm" role="listbox" aria-label="Existing tags">
                            @for (var index = 0; index < suggestions.Count; index++)
                            {
                                var suggestionIndex = index;
                                var tag = suggestions[index];
                                <button type="button" id="@($"{suggestionsId}-{index}")" tabindex="-1" role="option"
                                        class="list-group-item list-group-item-action @(index == activeTagSuggestionIndex ? "active" : null)"
                                        aria-selected="@(index == activeTagSuggestionIndex ? "true" : "false")"
                                        @onmousedown:preventDefault="true" @onmouseover="() => activeTagSuggestionIndex = suggestionIndex"
                                        @onclick="() => AddTag(tag)" disabled="@responding">@tag</button>
                            }
                            @if (suggestions.Count == 0)
                            {
                                <div class="list-group-item text-body-secondary" role="status">No matching tags.</div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
